    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.qysley.se/arn/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer API token",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "websiteUrl": "https://qysley.se/projects.html"
}
