{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hawaleska/arn-konsumenttvist",
  "title": "ARN Konsumenttvist",
  "description": "Svensk MCP-server för sökning och analys av ARN-beslut och konsumenttvister.",
  "version": "1.0.3",
  "repository": {
